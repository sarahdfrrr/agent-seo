# ─────────────────────────────────────────────────────────────────────────
# Sources de données — "mock" (défaut, données de démo) ou "live"
# ─────────────────────────────────────────────────────────────────────────
# Chaque canal peut passer en données réelles indépendamment. Laisse à
# "mock" (ou supprime la ligne) tant que les identifiants correspondants
# ne sont pas renseignés ci-dessous.
DATA_SOURCE_GA4=mock
DATA_SOURCE_SEO=mock
DATA_SOURCE_ADS=mock
DATA_SOURCE_EMAIL=mock
DATA_SOURCE_SOCIAL=mock

# ─────────────────────────────────────────────────────────────────────────
# Google (GA4 + Search Console) — compte de service partagé
# ─────────────────────────────────────────────────────────────────────────
# 1. Google Cloud Console > IAM & Admin > Comptes de service > créer.
# 2. Activer "Google Analytics Data API" et "Google Search Console API".
# 3. Créer une clé JSON pour le compte de service, en extraire les 2 valeurs
#    ci-dessous (colle GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY avec des \n littéraux,
#    ou entre guillemets si ta plateforme d'hébergement gère les retours ligne).
# 4. GA4 : Admin > Gestion des accès à la propriété > ajouter l'email du
#    compte de service en "Lecteur".
# 5. Search Console : Paramètres > Utilisateurs et autorisations > ajouter
#    l'email du compte de service.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# GA4 : Admin > Détails de la propriété > Identifiant de propriété
GA4_PROPERTY_ID=

# Search Console : l'URL exactement telle qu'affichée (ex: sc-domain:exemple.com
# pour une propriété de domaine, ou https://www.exemple.com/ pour une propriété URL)
GSC_SITE_URL=

# YouTube (réutilise le même compte de service, à ajouter comme gestionnaire
# de la chaîne dans YouTube Studio > Paramètres > Autorisations)
YOUTUBE_CHANNEL_ID=

# ─────────────────────────────────────────────────────────────────────────
# Google Ads
# ─────────────────────────────────────────────────────────────────────────
# Développeur token depuis le Centre API de ton compte Google Ads (MCC) —
# nécessite une validation par Google pour l'accès en production.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Identifiants OAuth d'une app Google Cloud (Google Ads API activée)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Obtenu une fois via le flux de consentement OAuth (voir doc Google Ads API)
GOOGLE_ADS_REFRESH_TOKEN=
# Identifiant du compte Google Ads à lire, 10 chiffres sans tirets
GOOGLE_ADS_CUSTOMER_ID=
# Optionnel — si le compte est géré sous un compte manager (MCC)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ─────────────────────────────────────────────────────────────────────────
# Mailchimp
# ─────────────────────────────────────────────────────────────────────────
# Compte > Extras > API keys. Le préfixe serveur (ex: us21) est déduit
# automatiquement de la clé.
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# ─────────────────────────────────────────────────────────────────────────
# LinkedIn (organique — nécessite un app LinkedIn avec Community Management
# API approuvée sur ta Page)
# ─────────────────────────────────────────────────────────────────────────
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=

# ─────────────────────────────────────────────────────────────────────────
# Instagram (organique — via l'API Graph de Facebook, compte Business/Creator
# lié à une Page Facebook)
# ─────────────────────────────────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
